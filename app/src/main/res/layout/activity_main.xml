<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apex_bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.apex.ai.ui.widget.AuroraBackgroundView
            android:id="@+id/aurora"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageButton
                    android:id="@+id/btnAgents"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_ripple"
                    android:contentDescription="@string/action_agents"
                    android:padding="10dp"
                    android:src="@drawable/ic_agent"
                    app:tint="@color/apex_violet" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAgentName"
                        style="@style/Apex.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apex" />

                    <TextView
                        android:id="@+id/tvAgentStatus"
                        style="@style/Apex.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ready" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnTools"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_ripple"
                    android:contentDescription="@string/action_tools"
                    android:padding="10dp"
                    android:src="@drawable/ic_tools"
                    app:tint="@color/apex_text_dim" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_ripple"
                    android:contentDescription="@string/action_settings"
                    android:padding="10dp"
                    android:src="@drawable/ic_key"
                    app:tint="@color/apex_text_dim" />
            </LinearLayout>

            <!-- Conversation -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerChat"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none" />

                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:text="◈"
                        android:textColor="@color/apex_violet"
                        android:textSize="52sp" />

                    <TextView
                        style="@style/Apex.Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/empty_title" />

                    <TextView
                        style="@style/Apex.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.3"
                        android:text="@string/empty_subtitle" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/suggestionRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </FrameLayout>

            <!-- Composer -->
            <LinearLayout
                android:id="@+id/composerRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_composer"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp">

                <ImageButton
                    android:id="@+id/btnNewChat"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_ripple"
                    android:contentDescription="@string/action_new_chat"
                    android:padding="9dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/apex_text_dim" />

                <EditText
                    android:id="@+id/inputPrompt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint_composer"
                    android:imeOptions="actionSend|flagNoEnterAction"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:minHeight="42dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/apex_text"
                    android:textColorHint="@color/apex_text_faint"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_send_button"
                    android:contentDescription="@string/action_send"
                    android:padding="10dp"
                    android:src="@drawable/ic_send"
                    app:tint="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Drawer -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/apex_bg_alt"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            style="@style/Apex.Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Agents" />

        <TextView
            style="@style/Apex.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Single, autonomous or team" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAgents"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            style="@style/Apex.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Apex AI · 1.0-beta" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
