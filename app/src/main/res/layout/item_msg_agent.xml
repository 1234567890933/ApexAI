<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="6dp"
    android:paddingEnd="40dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:text="◈"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvAgentName"
            style="@style/Apex.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Apex" />
    </LinearLayout>

    <com.apex.ai.ui.widget.GlassCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="13dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvBody"
                style="@style/Apex.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true" />

            <LinearLayout
                android:id="@+id/actionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnRetry"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_ripple"
                    android:contentDescription="@string/action_retry"
                    android:padding="9dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/apex_text_faint" />

                <ImageButton
                    android:id="@+id/btnCopy"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_ripple"
                    android:contentDescription="@string/action_copy"
                    android:padding="9dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/apex_text_faint" />

                <ImageButton
                    android:id="@+id/btnSpeak"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_ripple"
                    android:contentDescription="@string/action_speak"
                    android:padding="9dp"
                    android:src="@drawable/ic_volume"
                    app:tint="@color/apex_text_faint" />
            </LinearLayout>
        </LinearLayout>
    </com.apex.ai.ui.widget.GlassCardView>
</LinearLayout>
